{
  "db_name": "PostgreSQL",
  "query": "SELECT n.pk, n.parent, n.is_file, n.current_version, l.pk AS library, l.owner, l.storage,\n                  a.can_write AS \"can_write!\"\n           FROM node n\n           JOIN library l ON l.pk = n.library\n           JOIN library_access($1) a ON a.library = l.pk\n           WHERE n.uuid = $2 AND node_reachable(n.pk)",
