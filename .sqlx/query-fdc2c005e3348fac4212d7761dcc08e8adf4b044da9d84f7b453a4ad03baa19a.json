{
  "db_name": "PostgreSQL",
  "query": "SELECT i.uuid AS id, i.kind, p.uuid AS \"provider?\", p.name AS \"provider_name?\"\n           FROM identity i LEFT JOIN identity_provider p ON p.pk = i.provider\n           WHERE i.account = $1 AND i.kind IN ('password', 'oidc')\n           ORDER BY i.kind DESC, lower(p.name)",
