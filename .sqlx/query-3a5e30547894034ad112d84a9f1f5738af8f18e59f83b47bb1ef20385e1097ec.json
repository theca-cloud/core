  "query": "SELECT u.uuid AS id, a.email, u.joined_at IS NOT NULL AS \"joined!\", o.owner = u.pk AS \"owner!\"\n           FROM \"user\" u JOIN account a ON a.pk = u.account JOIN organization o ON o.pk = u.organization\n           WHERE u.organization = $1 ORDER BY lower(a.email)",
