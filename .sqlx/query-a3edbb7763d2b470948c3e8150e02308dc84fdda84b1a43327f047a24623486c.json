  "query": "SELECT l.uuid AS id, o.uuid AS organization, l.name, n.uuid AS root\n           FROM library l\n           JOIN organization o ON o.pk = l.owner\n           JOIN node n ON n.library = l.pk AND n.parent IS NULL\n           WHERE l.pk = $1",
