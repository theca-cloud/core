{
  "db_name": "PostgreSQL",
  "query": "SELECT n.uuid AS id, n.name, n.is_file, node_path(n.pk) AS \"path!\", v.size AS \"size?\",\n                  n.deleted_at AS \"deleted_at!\"\n           FROM node n LEFT JOIN version v ON v.pk = n.current_version\n           WHERE n.library = $1 AND n.deleted_at IS NOT NULL ORDER BY n.deleted_at DESC",
