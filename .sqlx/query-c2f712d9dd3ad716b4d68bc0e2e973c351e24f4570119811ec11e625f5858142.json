{
  "db_name": "PostgreSQL",
  "query": "SELECT n.uuid AS id, n.name, n.is_file, v.created_at::text AS modified\n           FROM node n LEFT JOIN version v ON v.pk = n.current_version\n           WHERE n.parent = $1 AND n.deleted_at IS NULL ORDER BY n.is_file, lower(n.name)",
