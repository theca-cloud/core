  "query": "SELECT a.pk, a.uuid, i.details->>'hash' AS \"hash?\", a.verified,\n                  a.suspended_at IS NOT NULL AS \"suspended!\"\n           FROM account a LEFT JOIN identity i ON i.account = a.pk AND i.kind = 'password'\n           WHERE lower(a.email) = lower($1)",
