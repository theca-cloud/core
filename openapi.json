{
  "openapi": "3.1.0",
  "info": {
    "title": "Theca",
    "description": "",
    "license": {
      "name": "AGPL-3.0-only",
      "identifier": "AGPL-3.0-only"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [],
        "summary": "Readiness probe: 200 when the server can serve requests, 503 otherwise.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Not ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/chunks/announce": {
      "post": {
        "tags": [
          "v1"
        ],
        "summary": "Mark uploaded chunks as ready, after checking each object exists with the\ndeclared size. Returns the chunks still to upload (object missing): request\nnew URLs for them (same declaration).",
        "operationId": "announce",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Chunks"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Chunks not uploaded yet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Chunks"
                }
              }
            }
          },
          "403": {
            "description": "`chunk_not_allowed`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/chunks/cancel": {
      "post": {
        "tags": [
          "v1"
        ],
        "summary": "Cancel an upload: tombstones the given chunks that no version references.\nTheir objects are deleted later, once their upload URLs have expired.",
        "operationId": "cancel",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Chunks"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": ""
          }
        }
      }
    },
    "/api/v1/chunks/lookup": {
      "post": {
        "tags": [
          "v1"
        ],
        "summary": "Which chunks to upload. Misses become pending chunks; every chunk returned is\ntouched (repeat the lookup as a keepalive during long uploads).",
        "operationId": "lookup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Lookup"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LookupEntry"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/chunks/upload-urls": {
      "post": {
        "tags": [
          "v1"
        ],
        "summary": "Declare what will be uploaded and get presigned upload URLs (in batches).\nThe declaration is fixed at the first request; the URL only accepts exactly\nthe declared bytes (their SHA-256 is signed). Checks the organization's quota.",
        "operationId": "upload_urls",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Declare"
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ChunkUrl"
                  }
                }
              }
            }
          },
          "400": {
            "description": "`invalid_declaration`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "`chunk_not_allowed`: not pending, or not writable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "`declaration_mismatch`, `quota_exceeded`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/files/commit": {
      "post": {
        "tags": [
          "v1"
        ],
        "summary": "Commit a version: a new file (`parent` + `name`) or a new version (`file`).",
        "operationId": "commit",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Commit"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Committed"
                }
              }
            }
          },
          "403": {
            "description": "Chunks not allowed (`chunk_not_allowed`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "`name_taken`, `chunk_missing`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/files/{id}/download": {
      "get": {
        "tags": [
          "v1"
        ],
        "summary": "The current version's chunks, in order, with presigned download URLs.",
        "operationId": "download",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Download"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/libraries": {
      "get": {
        "tags": [
          "v1"
        ],
        "summary": "The libraries the user is a member of.",
        "operationId": "list_libraries",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Library"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "v1"
        ],
        "summary": "Create a library: its root folder, the creator as `write` member, in the given\nnamespaces. Storage: the organization's default, else the instance default.",
        "operationId": "create_library",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateLibrary"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Library"
                }
              }
            }
          },
          "404": {
            "description": "Unknown namespace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Name taken, or no storage configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/nodes/{id}/children": {
      "get": {
        "tags": [
          "v1"
        ],
        "summary": "A folder's children.",
        "operationId": "children",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Node"
                  }
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/version": {
      "get": {
        "tags": [],
        "summary": "Server version and supported API majors.",
        "operationId": "version",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Version"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "description": "An API error: a stable machine-readable `code` and a human message.",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "chunks": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Chunks concerned, for `chunk_missing` and `chunk_not_allowed`."
          },
          "code": {
            "type": "string",
            "description": "Stable identifier, e.g. `name_taken`, `chunk_missing`."
          },
          "message": {
            "type": "string",
            "description": "Explanation for humans."
          }
        }
      },
      "ChunkState": {
        "type": "string",
        "description": "Whether a chunk must be uploaded.",
        "enum": [
          "ready",
          "upload",
          "unknown"
        ]
      },
      "ChunkUrl": {
        "type": "object",
        "description": "A presigned URL for one chunk.",
        "required": [
          "chunk",
          "url"
        ],
        "properties": {
          "chunk": {
            "type": "string",
            "format": "uuid",
            "description": "The chunk."
          },
          "headers": {
            "type": "object",
            "description": "Headers to send with the request, exactly (they are signed).",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "url": {
            "type": "string",
            "description": "Where to `PUT` (upload) or `GET` (download) it, without authentication."
          }
        }
      },
      "Chunks": {
        "type": "object",
        "description": "A list of chunks (`/chunks/announce`, `/chunks/cancel`).",
        "required": [
          "chunks"
        ],
        "properties": {
          "chunks": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The chunks."
          }
        }
      },
      "Commit": {
        "type": "object",
        "description": "`POST /files/commit`: either `file` (a new version of an existing file) or\n`parent` + `name` (a new file).",
        "required": [
          "library",
          "chunks"
        ],
        "properties": {
          "base_version": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "The version the client started from (none for a new file)."
          },
          "chunks": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The file's chunks, in order."
          },
          "file": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "An existing file."
          },
          "library": {
            "type": "string",
            "format": "uuid",
            "description": "The library."
          },
          "message": {
            "type": [
              "string",
              "null"
            ],
            "description": "Description of the version."
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "The name of a new file."
          },
          "parent": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "The folder of a new file."
          }
        }
      },
      "Committed": {
        "type": "object",
        "description": "The result of a commit.",
        "required": [
          "file",
          "version",
          "conflict"
        ],
        "properties": {
          "conflict": {
            "type": "boolean",
            "description": "The base wasn't the current version: another branch exists."
          },
          "file": {
            "type": "string",
            "format": "uuid",
            "description": "The file."
          },
          "version": {
            "type": "string",
            "format": "uuid",
            "description": "The new version, now current."
          }
        }
      },
      "CreateLibrary": {
        "type": "object",
        "description": "`POST /libraries`.",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "The library name (same rules as file names)."
          },
          "namespaces": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Existing namespaces of the organization to put the library in. Empty:\nthe library only dedups with itself."
          }
        }
      },
      "Declare": {
        "type": "object",
        "description": "One chunk of `POST /chunks/upload-urls`: what the client will upload. Fixed\nat the first request; a later request (expired URL) must repeat it exactly.",
        "required": [
          "chunk",
          "stored_size",
          "compression",
          "stored_sha256"
        ],
        "properties": {
          "chunk": {
            "type": "string",
            "format": "uuid",
            "description": "A pending chunk from the lookup."
          },
          "compression": {
            "type": "string",
            "description": "How those bytes are compressed."
          },
          "stored_sha256": {
            "type": "string",
            "description": "SHA-256 of those bytes: the upload URL only accepts exactly them."
          },
          "stored_size": {
            "type": "integer",
            "format": "int64",
            "description": "Size of the bytes to upload (after compression), at most `plain_size`.",
            "minimum": 0
          }
        }
      },
      "Download": {
        "type": "object",
        "description": "`GET /files/{id}/download`.",
        "required": [
          "version",
          "chunks"
        ],
        "properties": {
          "chunks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DownloadChunk"
            },
            "description": "Its chunks, in order."
          },
          "version": {
            "type": "string",
            "format": "uuid",
            "description": "The version downloaded (the current one)."
          }
        }
      },
      "DownloadChunk": {
        "type": "object",
        "description": "One chunk of a download, in order.",
        "required": [
          "chunk",
          "hash",
          "compression",
          "plain_size",
          "url"
        ],
        "properties": {
          "chunk": {
            "type": "string",
            "format": "uuid",
            "description": "The chunk."
          },
          "compression": {
            "type": "string",
            "description": "How it's compressed."
          },
          "hash": {
            "type": "string",
            "description": "Its hash, to verify the downloaded plaintext."
          },
          "plain_size": {
            "type": "integer",
            "format": "int64",
            "description": "Its size once decompressed.",
            "minimum": 0
          },
          "url": {
            "type": "string",
            "description": "Presigned `GET` URL."
          }
        }
      },
      "Health": {
        "type": "object",
        "description": "Health report. The contract is the HTTP status (200 / 503); the body is informational.",
        "required": [
          "status",
          "checks"
        ],
        "properties": {
          "checks": {
            "type": "object",
            "description": "Each check: `ok` or `failing`. Details go to the logs, never here.",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "description": "`ok` or `failing`."
          }
        }
      },
      "Library": {
        "type": "object",
        "description": "A library.",
        "required": [
          "id",
          "name",
          "root"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "The library."
          },
          "name": {
            "type": "string",
            "description": "Its name."
          },
          "root": {
            "type": "string",
            "format": "uuid",
            "description": "Its root folder."
          }
        }
      },
      "Lookup": {
        "type": "object",
        "description": "`POST /chunks/lookup`.",
        "required": [
          "library",
          "chunks"
        ],
        "properties": {
          "chunks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LookupChunk"
            },
            "description": "The file's chunks."
          },
          "library": {
            "type": "string",
            "format": "uuid",
            "description": "The library being uploaded into."
          }
        }
      },
      "LookupChunk": {
        "type": "object",
        "description": "One chunk of a lookup.",
        "required": [
          "hash",
          "plain_size"
        ],
        "properties": {
          "hash": {
            "type": "string",
            "description": "Hash of the plaintext."
          },
          "plain_size": {
            "type": "integer",
            "format": "int64",
            "description": "Size of the plaintext (at most 8 MiB).",
            "minimum": 0
          }
        }
      },
      "LookupEntry": {
        "type": "object",
        "description": "One hash of a lookup.",
        "required": [
          "hash",
          "chunk",
          "state"
        ],
        "properties": {
          "chunk": {
            "type": "string",
            "format": "uuid",
            "description": "The chunk to reference in the commit."
          },
          "hash": {
            "type": "string",
            "description": "The hash looked up."
          },
          "state": {
            "$ref": "#/components/schemas/ChunkState",
            "description": "Upload it or not."
          }
        }
      },
      "Node": {
        "type": "object",
        "description": "A file or folder.",
        "required": [
          "id",
          "name",
          "is_file"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "The node."
          },
          "is_file": {
            "type": "boolean",
            "description": "A file (true) or a folder (false)."
          },
          "name": {
            "type": "string",
            "description": "Its name."
          }
        }
      },
      "Version": {
        "type": "object",
        "description": "Server and API versions, for clients to check compatibility.",
        "required": [
          "server",
          "api"
        ],
        "properties": {
          "api": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Supported major API versions."
          },
          "server": {
            "type": "string",
            "description": "Version of this server."
          }
        }
      }
    }
  }
}
